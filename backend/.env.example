# Revix System Backend Environment Configuration (Phase 1)
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (PostgreSQL 18 on this machine listens on port 5433)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/revix_system

# Allowed Next.js frontend origin for CORS + HttpOnly cookies
FRONTEND_ORIGIN=http://localhost:3000

# Session cookie configuration
SESSION_COOKIE_NAME=revix_session
SESSION_TTL_HOURS=168
