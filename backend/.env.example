# Revix System Backend Environment Configuration (Phase 1)
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (PostgreSQL 18 on this machine listens on port 5433)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/revix_system
UPLOADS_DIR=./uploads

# Allowed Next.js frontend origin for CORS + HttpOnly cookies
FRONTEND_ORIGIN=http://localhost:3000

# Session cookie configuration
SESSION_COOKIE_NAME=revix_session
SESSION_TTL_HOURS=168

# Keep verification optional while testing; set true to require it.
REQUIRE_EMAIL_VERIFICATION=false

# SMTP Email Delivery (Optional in local development; when omitted, clickable links log to terminal)
# To send real emails using Gmail (App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_FROM=Revix Car Rental <your_email@gmail.com>
#
# Or using Resend / Mailtrap / Brevo:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxx
# SMTP_FROM=Revix System <onboarding@resend.dev>
